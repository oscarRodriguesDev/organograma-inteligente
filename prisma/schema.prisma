generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enum de Papéis ───────────────────────────────
enum Papel {
  ADMIN_PLATAFORMA
  ADMIN_SUPORTE
  ADMIN_PSICH
  CEO
  DIRETOR
  GERENTE
  SUPERVISOR
  GESTOR
  LIDER
  OPERACIONAL
  RH
  COLABORADOR
}

// ─── Planos de Assinatura ─────────────────────────
model Plano {
  id               String   @id @default(cuid())
  nome             String
  slug             String   @unique
  descricao        String   @default("")
  precoMensal      Float    @default(0)
  precoAnual       Float    @default(0)
  maxColaboradores Int      @default(10)
  recursos         String   @default("[]") // JSON array
  destaque         Boolean  @default(false)
  ativo            Boolean  @default(true)
  ordem            Int      @default(0)   // ordem de exibição

  // ─── Promoções ─────────────────────────────────
  descontoPercentual Float   @default(0)  // 0 = sem desconto
  promocaoAtiva      Boolean @default(false)
  promocaoValidade   DateTime?
  promocaoDescricao  String  @default("")

  createdAt        DateTime @default(now())

  assinaturas      Assinatura[]
}

// ─── Assinatura da Empresa ─────────────────────────
model Assinatura {
  id                   String   @id @default(cuid())
  empresaId            String   @unique
  planoId              String
  status               String   @default("ativa") // ativa, cancelada, expirada, trial
  dataInicio           DateTime @default(now())
  dataProximoPagamento DateTime?
  dataCancelamento     DateTime?
  ciclo                String   @default("mensal") // mensal, anual
  createdAt            DateTime @default(now())

  empresa              Empresa  @relation(fields: [empresaId], references: [id])
  plano                Plano    @relation(fields: [planoId], references: [id])
  pagamentos           Pagamento[]
}

// ─── Pagamento (Mockado) ──────────────────────────
model Pagamento {
  id              String   @id @default(cuid())
  assinaturaId    String
  valor           Float
  metodo          String   @default("cartao_credito") // cartao_credito, boleto, pix
  status          String   @default("aprovado") // aprovado, pendente, recusado, estornado
  referenciaExterna String @default("")
  createdAt       DateTime @default(now())

  assinatura      Assinatura @relation(fields: [assinaturaId], references: [id])
}

// ─── Investimentos (admin financeiro) ─────────────
model Investimento {
  id          String   @id @default(cuid())
  descricao   String
  valor       Float
  data        DateTime @default(now())
  createdAt   DateTime @default(now())
}

// ─── Gastos do Sistema (admin financeiro) ─────────
model GastoSistema {
  id          String   @id @default(cuid())
  tipo        String   // dominio, hospedagem, anuncio, salario, ia, ferramentas, outros
  descricao   String
  valor       Float
  mes         Int
  ano         Int
  recorrente  Boolean  @default(false)
  fornecedor  String   @default("")
  observacao  String   @default("")
  createdAt   DateTime @default(now())
}

// ─── Empresa (Tenant) ─────────────────────────────
model Empresa {
  id            String   @id @default(cuid())
  nome          String
  slug          String   @unique
  cnpj          String   @default("")
  contatoNome   String   @default("")
  contatoEmail  String   @default("")
  contatoTelefone String @default("")
  dataContratacao DateTime @default(now())
  ativa         Boolean  @default(true)
  createdAt     DateTime @default(now())

  colaboradores      Colaborador[]
  cargos             Cargo[]
  regrasImpacto      RegraImpacto[]
  fitCulturalPerguntas FitCulturalPergunta[]
  perguntasDISC      PerguntaDISC[]
  assinatura         Assinatura?
  testesDisponiveis  EmpresaTesteDisponivel[]
}

model Colaborador {
  id              String   @id @default(cuid())
  empresaId       String?
  nome            String
  funcao          String
  email           String?  // email para login (nullable para migração)
  cpf             String?  // CPF do colaborador (usado para login cpf@empresa.com)
  senhaHash       String?  // hash da senha
  papel           Papel    @default(COLABORADOR)
  liderImediatoId String?
  fotoUrl         String?  // URL da foto de perfil
  username        String?  // nome de exibição/editável
  tema            String   @default("system") // light | dark | system
  createdAt       DateTime @default(now())
  status          String   @default("ativo")
  perfilComportamental String? // JSON - análise de perfil comportamental (gerada pelo agente analista-perfil-comportamental)
 
  empresa      Empresa?      @relation(fields: [empresaId], references: [id])
  lider        Colaborador?  @relation("LiderSubordinados", fields: [liderImediatoId], references: [id])
  subordinados Colaborador[] @relation("LiderSubordinados")

  avaliacoesRecebidas  Avaliacao[]           @relation("Avaliado")
  avaliacoesFeitas     Avaliacao[]           @relation("Avaliador")
  metricas             MetricaMensal[]
  iniciativas          Iniciativa[]
  fitCulturalRespostas FitCulturalResposta[]
  respostasDISC        RespostaDISC[]
  resultadoDISC        ResultadoDISC?
  pesquisasSentimento  PesquisaSentimento[]
  conversas            Conversa[]            @relation("ConversaColaborador")
  conversasCriadas     Conversa[]            @relation("CriadorConversa")
  projetos             Projeto[]
  projetoParticipantes ProjetoParticipante[]
  scores               ScoreColaborador?
  testesCriados        TestePsicologico[]
  testesAtribuidos     TesteAtribuido[]      @relation("AtribuidorTeste")
  testesRecebidos      TesteAtribuido[]      @relation("RecebedorTeste")
  respostasTestes      RespostaTesteColaborador[]
  advertencias         Advertencia[]
  advertenciasAplicadas Advertencia[]        @relation("AdvertenciaAplicador")
  suspensoes           Suspensao[]
  suspensoesAplicadas  Suspensao[]           @relation("SuspensaoAplicador")
  analisesIA           AnaliseImpactoIA[]

  @@unique([empresaId, email])
}

model Avaliacao {
  id              String   @id @default(cuid())
  avaliadorId     String
  avaliadoId      String
  data            DateTime @default(now())
  criterios       String
  comentarioGeral String   @default("")

  avaliador Colaborador @relation("Avaliador", fields: [avaliadorId], references: [id], onDelete: Cascade)
  avaliado  Colaborador @relation("Avaliado", fields: [avaliadoId], references: [id], onDelete: Cascade)
}

model MetricaMensal {
  id                  String   @id @default(cuid())
  colaboradorId       String
  mes                 Int
  ano                 Int
  diasTrabalhados     Int
  faltasInjustificadas Int
  horasAtraso         Int
  observacao          String   @default("")
  scorecard           String   @default("{}") // JSON com categorias, pesos, indicadores e nota final
  data                DateTime @default(now())

  colaborador Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
}

model Iniciativa {
  id             String   @id @default(cuid())
  colaboradorId  String
  titulo         String
  descricao      String   @default("")
  resultado      String   @default("")
  valorResultado Float
  unidadeMedida  String   @default("")
  status         String   @default("pendente") // pendente, aprovada, recusada
  data           DateTime @default(now())

  colaborador Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
}

model Advertencia {
  id             String   @id @default(cuid())
  colaboradorId  String
  titulo         String
  descricao      String   @default("")
  tipo           String   @default("leve") // leve, media, grave
  aplicadaPorId  String
  data           DateTime @default(now())
  createdAt      DateTime @default(now())

  colaborador  Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  aplicadaPor  Colaborador @relation("AdvertenciaAplicador", fields: [aplicadaPorId], references: [id])
}

model Suspensao {
  id             String    @id @default(cuid())
  colaboradorId  String
  motivo         String
  dataInicio     DateTime
  dataFim        DateTime?
  aplicadaPorId  String
  observacao     String    @default("")
  createdAt      DateTime  @default(now())

  colaborador  Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  aplicadaPor  Colaborador @relation("SuspensaoAplicador", fields: [aplicadaPorId], references: [id])
}

model RegraImpacto {
  id        String  @id @default(cuid())
  empresaId String
  nome      String
  descricao String  @default("")
  tipo      String
  condicao  String
  ativa     Boolean @default(true)

  empresa Empresa @relation(fields: [empresaId], references: [id])
}

model Cargo {
  id        String @id @default(cuid())
  empresaId String
  nome      String

  empresa Empresa @relation(fields: [empresaId], references: [id])
  @@unique([empresaId, nome])
}

// ─── Teste Fit Cultural ────────────────────────────────
model FitCulturalPergunta {
  id          String   @id @default(cuid())
  empresaId   String
  pergunta    String
  dimensao    String   // 'valores' | 'comportamento' | 'comunicacao' | 'lideranca' | 'inovacao'
  peso        Int      @default(1)
  ativa       Boolean  @default(true)
  ordem       Int      @default(0)
  createdAt   DateTime @default(now())

  empresa  Empresa              @relation(fields: [empresaId], references: [id])
  respostas FitCulturalResposta[]
}

model FitCulturalResposta {
  id             String   @id @default(cuid())
  colaboradorId  String
  perguntaId     String
  nota           Int      // 1-5
  respondidoEm   DateTime @default(now())
  colaborador    Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  pergunta       FitCulturalPergunta @relation(fields: [perguntaId], references: [id])
}

// ─── Teste DISC ─────────────────────────────────────────
model PerguntaDISC {
  id          String   @id @default(cuid())
  empresaId   String
  pergunta    String
  dimensao    String   // 'D' (Dominância) | 'I' (Influência) | 'S' (Estabilidade) | 'C' (Conformidade)
  peso        Int      @default(1)
  ativa       Boolean  @default(true)
  createdAt   DateTime @default(now())

  empresa  Empresa        @relation(fields: [empresaId], references: [id])
  respostas RespostaDISC[]
}

model RespostaDISC {
  id             String   @id @default(cuid())
  colaboradorId  String
  perguntaId     String
  nota           Int      // 1-5
  respondidoEm   DateTime @default(now())
  colaborador    Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  pergunta       PerguntaDISC @relation(fields: [perguntaId], references: [id])
}

model ResultadoDISC {
  id             String   @id @default(cuid())
  colaboradorId  String   @unique
  perfil         String   // ex: "D", "I", "S", "C", "DI", "ISC", etc.
  pontuacaoD     Int      @default(0)
  pontuacaoI     Int      @default(0)
  pontuacaoS     Int      @default(0)
  pontuacaoC     Int      @default(0)
  data           DateTime @default(now())
  colaborador    Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
}

// ─── Pesquisa de Sentimento ────────────────────────────
model PesquisaSentimento {
  id             String   @id @default(cuid())
  colaboradorId  String
  sentimento     String   // 'muito_positivo' | 'positivo' | 'neutro' | 'negativo' | 'muito_negativo'
  nota           Int      // 1-5 (overall)
  engajamento    Int?     // 1-5
  motivacao      Int?     // 1-5
  pertencimento  Int?     // 1-5
  comentario     String   @default("")
  respondidoEm   DateTime @default(now())
  colaborador    Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
}

// ─── Registro de Conversas ─────────────────────────────
model Conversa {
  id              String   @id @default(cuid())
  colaboradorId   String
  tipo            String   // '1:1' | 'feedback' | 'avaliacao' | 'alinhamento' | 'desligamento' | 'outro'
  titulo          String
  assunto         String   @default("")
  resumo          String   @default("")
  observacoes     String   @default("")
  pontosPositivos String   @default("")
  pontosMelhoria  String   @default("")
  realizadaEm     DateTime @default(now())
  registradaEm    DateTime @default(now())
  criadoPorId     String?
  colaborador     Colaborador @relation("ConversaColaborador", fields: [colaboradorId], references: [id], onDelete: Cascade)
  criadoPor       Colaborador? @relation("CriadorConversa", fields: [criadoPorId], references: [id], onDelete: SetNull)
}

// ─── Score Consolidado do Colaborador ──────────────────
model ScoreColaborador {
  id                  String   @id @default(cuid())
  colaboradorId       String   @unique
  scoreGeral          Float    @default(0)    // 0-10 consolidado
  scoreFitCultural    Float    @default(0)    // 0-10
  scoreDISC           Float    @default(0)    // 0-10
  scoreSentimento     Float    @default(0)    // 0-10
  scoreConversas      Float    @default(0)    // 0-10
  scoreAvaliacoes     Float    @default(0)    // 0-10 (média das avaliações)
  scoreMetricas       Float    @default(0)    // 0-10
  scoreIniciativas    Float    @default(0)    // 0-10
  ultimaAtualizacao   DateTime @default(now())
  colaborador Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
}

// ─── Testes Psicológicos (admin_psich) ─────────────
model TestePsicologico {
  id          String   @id @default(cuid())
  titulo      String
  descricao   String   @default("")
  instrucoes  String   @default("")
  tipo        String   @default("personalidade") // personalidade, comportamental, perfil, etc
  criadoPorId String?
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  criadoPor   Colaborador?               @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)
  perguntas   PerguntaTestePsicologico[]
  empresasDisponiveis EmpresaTesteDisponivel[]
  respostas   RespostaTesteColaborador[]
  atribuicoes TesteAtribuido[]
}

model PerguntaTestePsicologico {
  id            String   @id @default(cuid())
  testeId       String
  pergunta      String
  tipo          String   @default("escala_1_5") // multipla_escolha, escala_1_5, texto, verdadeiro_falso
  opcoes        String   @default("[]")          // JSON array para multipla_escolha
  peso          Int      @default(1)
  ordem         Int      @default(0)
  obrigatoria   Boolean  @default(true)

  teste         TestePsicologico           @relation(fields: [testeId], references: [id], onDelete: Cascade)
  respostas     RespostaTesteColaborador[]
}

/// Disponibilidade do teste para uma empresa
model EmpresaTesteDisponivel {
  id        String   @id @default(cuid())
  testeId   String
  empresaId String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  teste   TestePsicologico @relation(fields: [testeId], references: [id], onDelete: Cascade)
  empresa Empresa          @relation(fields: [empresaId], references: [id])

  @@unique([testeId, empresaId])
}

/// Atribuição de um teste psicológico a um colaborador por um gestor
/// Cada atribuição gera um token único -> link exclusivo para responder
model TesteAtribuido {
  id             String   @id @default(cuid())
  testeId        String
  colaboradorId  String
  atribuidoPorId String
  token          String   @unique @default(cuid()) // link único: /responder/[token]
  status         String   @default("pendente")     // pendente, concluido
  atribuidoEm    DateTime @default(now())
  respondidoEm   DateTime?

  teste         TestePsicologico @relation(fields: [testeId], references: [id], onDelete: Cascade)
  colaborador   Colaborador     @relation("RecebedorTeste", fields: [colaboradorId], references: [id], onDelete: Cascade)
  atribuidoPor  Colaborador     @relation("AtribuidorTeste", fields: [atribuidoPorId], references: [id])
}

/// Resposta de um colaborador a um teste psicológico
model RespostaTesteColaborador {
  id              String   @id @default(cuid())
  testeId         String
  colaboradorId   String
  perguntaId      String
  resposta        String   // JSON: valor da resposta (nota, texto, opção selecionada)
  respondidoEm    DateTime @default(now())

  teste         TestePsicologico        @relation(fields: [testeId], references: [id], onDelete: Cascade)
  pergunta      PerguntaTestePsicologico @relation(fields: [perguntaId], references: [id], onDelete: Cascade)
  colaborador   Colaborador             @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  @@unique([testeId, colaboradorId, perguntaId])
}

// ─── Log de Webhooks (Asaas) ────────────────────────
model WebhookLog {
  id        String   @id @default(cuid())
  evento    String   // PAYMENT_RECEIVED, PAYMENT_CONFIRMED, etc.
  asaasPaymentId String @default("") // ID do pagamento no Asaas
  externalReference String @default("") // externalReference enviado
  status    String   @default("") // status mapeado (aprovado, pendente, etc.)
  payload   String   @default("") // JSON bruto do payload recebido
  processado Boolean @default(false) // se foi processado com sucesso
  erro      String?  // mensagem de erro se houver
  createdAt DateTime @default(now())
}

model Impacto {
  id            String   @id @default(cuid())
  casoUso       String   // 'sugerir_candidatos' | 'feedback_avaliacao' | 'iniciativa' | 'sentimento' | 'cache'
  provider      String   @default("nvidia")
  model         String   @default("")
  tokensIn      Int      @default(0)
  tokensOut     Int      @default(0)
  latencyMs     Int      @default(0)
  erro          String?
  resposta      String?
  cacheKey      String?
  createdAt     DateTime @default(now())
}

// ─── Análises de Impacto da IA (cache) ────────────────
model AnaliseImpactoIA {
  id             String   @id @default(cuid())
  colaboradorId  String
  tipoAcao       String   // 'demissao' | 'promocao'
  resultado      String   // JSON completo da análise (AnaliseImpacto)
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  colaborador    Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  @@unique([colaboradorId, tipoAcao])
}

// ─── Projetos dos Colaboradores ────────────────────────
model Projeto {
  id             String   @id @default(cuid())
  colaboradorId  String
  nome           String
  descricao      String   @default("")
  status         String   @default("em_andamento") // em_andamento, concluido, pausado, cancelado
  dataInicio     DateTime @default(now())
  dataFim        DateTime?
  createdAt      DateTime @default(now())

  colaborador    Colaborador          @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  participantes  ProjetoParticipante[]
}

model ProjetoParticipante {
  id             String   @id @default(cuid())
  projetoId      String
  colaboradorId  String
  responsabilidade String
  peso           Int      // 1 a 5
  createdAt      DateTime @default(now())

  projeto        Projeto    @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  colaborador    Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  @@unique([projetoId, colaboradorId])
}
